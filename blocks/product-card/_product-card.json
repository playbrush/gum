{
  "definitions": [
    {
      "title": "Product Card",
      "id": "product-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Product Card",
              "model": "product-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-card",
      "fields": [
        {
          "component": "container",
          "name": "badges",
          "label": "Badges",
          "collapsible": false,
          "fields": [
            {
              "component": "boolean",
              "name": "content_isNew",
              "label": "New"
            },
            {
              "component": "boolean",
              "name": "content_isBestSeller",
              "label": "Best Seller"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_name",
          "label": "Product Name"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "content_nameType",
          "label": "Name Heading Level",
          "value": "h3",
          "options": [
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_price",
          "label": "Price",
          "description": "e.g. £12.99"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_rating",
          "label": "Rating",
          "description": "Numeric score, e.g. 4.9"
        },
        {
          "component": "container",
          "name": "ctas",
          "label": "Call to Actions",
          "collapsible": false,
          "fields": [
            {
              "component": "boolean",
              "name": "content_addToCart",
              "label": "Add to Cart"
            },
            {
              "component": "boolean",
              "name": "content_buyInStore",
              "label": "Buy in Store"
            }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Product Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text"
        }
      ]
    }
  ],
  "filters": []
}
