{
  "definitions": [
    {
      "title": "Product Slider",
      "id": "product-slider",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Product Slider",
              "model": "product-slider",
              "filter": "product-slider"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-slider",
      "fields": [
        {
          "component": "text",
          "name": "ctaLabel",
          "label": "CTA Label",
          "valueType": "string",
          "validation": {
            "maxLength": 30,
            "customErrorMsg": "Maximum 30 characters."
          }
        },
        {
          "component": "aem-content",
          "name": "ctaLink",
          "label": "CTA Link",
          "valueType": "string"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "decorativeImage",
          "label": "Decorative Image",
          "description": "Optional photo shown on the right side of the slider (e.g. person holding product)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "decorativeImageAlt",
          "label": "Decorative Image Alt Text"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "product-slider",
      "components": ["slider-product-card"]
    }
  ]
}
