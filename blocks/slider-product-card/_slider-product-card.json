{
  "definitions": [
    {
      "title": "Slider Product Card",
      "id": "slider-product-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Slider Product Card",
              "model": "slider-product-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "slider-product-card",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "content_badge",
          "label": "Badge Type",
          "value": "New",
          "options": [
            { "name": "New", "value": "New" },
            { "name": "Best Seller", "value": "Best Seller" },
            { "name": "Online Only", "value": "Online Only" },
            { "name": "Featured Product", "value": "Featured Product" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_name",
          "label": "Product Name",
          "value": "",
          "required": true,
          "validation": {
            "maxLength": 40,
            "customErrorMsg": "Maximum 40 characters."
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "content_nameType",
          "label": "Name Heading Level",
          "value": "h3",
          "options": [
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_description",
          "label": "Description",
          "value": "",
          "required": true,
          "validation": {
            "maxLength": 120,
            "customErrorMsg": "Maximum 120 characters."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_rating",
          "label": "Rating",
          "description": "Numeric score e.g. 4.9",
          "value": "",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_ctaLabel",
          "label": "CTA Button Label",
          "description": "Shown on hover. Leave empty to hide the button.",
          "value": "",
          "validation": {
            "maxLength": 20,
            "customErrorMsg": "Maximum 20 characters."
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Product Image",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "value": "",
          "required": true
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "decorativeImage",
          "label": "Right Side Image",
          "description": "Optional image shown on the right side of the slider for this product.",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "decorativeImageAlt",
          "label": "Right Side Image Alt Text",
          "value": ""
        }
      ]
    }
  ],
  "filters": []
}
